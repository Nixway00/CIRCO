# Supabase (service role: server only, never in the site)
SUPABASE_URL=https://rgpzaqcnenpjpkzguqql.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Solana
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CIRCO_MINT=
PRIZE_WALLET_SECRET=        # base58 secret key of the prize wallet (holds one prize at a time)
PRIZE_WALLET_ADDRESS=       # public address of the prize wallet (webhook matching)
BUYBACK_WALLET_SECRET=      # base58 secret key of the buyback wallet
TEAM_WALLET=                # public address

# Webhooks
HELIUS_WEBHOOK_SECRET=      # shared secret set in the Helius webhook "auth header"
ENGINE_API_SECRET=          # shared secret between the site and the engine
PORT=8787

# X (optional): posts every pop without links ($0.015 per post)
# OAuth 2 app with scopes tweet.write users.read offline.access; X_REFRESH_TOKEN only seeds the first run
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
