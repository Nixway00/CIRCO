# Supabase (service role: server only, never in the site)
SUPABASE_URL=https://rgpzaqcnenpjpkzguqql.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Solana
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CIRCO_MINT=
PRIZE_WALLET_SECRET=        # base58 secret key of the prize wallet (holds one prize at a time)
PRIZE_WALLET_ADDRESS=       # public address of the prize wallet (webhook matching)
BUYBACK_WALLET_SECRET=      # base58 secret key of the buyback wallet
TEAM_WALLET=                # public address (its top-ups to the prize wallet, like the 0.01 SOL reserve, are not counted as fees)
IGNORE_FEE_FROM=            # optional comma list of more wallets whose transfers to the prize wallet are not fees

# Webhooks
HELIUS_WEBHOOK_SECRET=      # shared secret set in the Helius webhook "auth header"
ENGINE_API_SECRET=          # shared secret between the site and the engine
PORT=8787

# X (optional): posts every pop without links ($0.015 per post)
# OAuth 2 app with scopes tweet.write users.read offline.access; X_REFRESH_TOKEN only seeds the first run
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# pump.fun chat (optional). Reading the coin's chat needs nothing.
# To let the Ringmaster announce winners there, give the engine the key of the wallet the coin was launched
# from (its pump.fun profile is the Ringmaster's, and its lines carry the creator badge). The engine logs in
# to pump.fun by itself and refreshes the session twice a day. Keep only a little SOL on that wallet.
RINGMASTER_WALLET_SECRET=
# manual alternative: a pump.fun session token
PUMPFUN_CHAT_TOKEN=
